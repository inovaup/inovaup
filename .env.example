# Copie para .env.local (que não vai para o Git) e preencha com os dados do SEU projeto Supabase de desenvolvimento.
# Painel do Supabase > Project Settings > API. Nunca coloque valores reais neste arquivo.

NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-chave-publishable-ou-anon

# Chave secreta (service_role): só no .env.local, só para o script de semente
# e para src/modules/avaliacao/calculo/executar.ts. Nunca com o prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
